# Copy to .env — docker compose picks it up automatically.

# Port the app is served on (http://localhost:8080)
WEB_PORT=8080

# Load ~46 sample members on the very first start. Set to false for an empty, real gym.
SEED_DEMO=true

# User/group the backend runs as inside the container. On Linux use your own ids
# (run `id -u` / `id -g`) so the DB/ folder stays writable. Defaults are fine on Docker Desktop.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# Automatic WhatsApp sending (WhatsApp Business Cloud API) — optional.
# Leave empty to keep the free one-click mode. Keep this file out of git (.env is git-ignored).
# See the setup guide in the app: Plans & settings -> "WhatsApp automatic sending".
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# true = pretend to send (logged by the server, nothing leaves your machine) — handy for testing
WHATSAPP_DRY_RUN=false
# Hour of day (server time) when the daily automatic-reminder rules run
AUTO_REMINDER_HOUR=9
